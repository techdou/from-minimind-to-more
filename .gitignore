# ─────────────────────────────────────────────
# 依赖与构建产物
# ─────────────────────────────────────────────
node_modules/
dist/
# manifest.json 是 build:content 生成物,card-configs.js 是手工源文件必须进 git
# (目录整体忽略后 ! 否定无效,必须用 * 形式)
src/data/*
!src/data/card-configs.js
*.log

# ─────────────────────────────────────────────
# 开发工具配置目录(不上传)
# ─────────────────────────────────────────────
.zcode/
.claude/
.wrangler/
.vscode/
.idea/
.DS_Store
__pycache__/

# ─────────────────────────────────────────────
# 私密信息(密钥/凭证不泄露,防御性规则)
# ─────────────────────────────────────────────
.env
.env.*
.dev.vars
*.pem
*.key

# ─────────────────────────────────────────────
# 内部文档(不纳入版本控制,防开发状态泄漏)
# ─────────────────────────────────────────────
README.dev.md
**/*HANDOVER*.md
**/*HANDOFF*.md

# ─────────────────────────────────────────────
# 写作原稿与本地素材(内容以 content/ 为权威源)
# ─────────────────────────────────────────────
/*.md
!README.md
/图标.png

# ─────────────────────────────────────────────
# 截图与中间产物
# ─────────────────────────────────────────────
screenshots/
output/

# 播客中间产物(只保留 mp3 和 dialogue JSON 到 public/)
podcast/audio/**/*.wav
podcast/audio/**/manifest.json
podcast/audio/**/subtitles.srt

# Remotion 视频工程产物(源码保留,out/ 渲染产物和音频排除)
podcast/audio/**/remotion-video-projects/**/out/
podcast/audio/**/remotion-video-projects/**/public/audio.mp3

# 成品视频统一放 public/podcast/video/ 进 git,podcast/video/ 是中间副本
podcast/video/

# ── 2026-10-27 统一范式补全（与 techdou 仓 .gitignore 标准对齐）──

# ── 私密信息与密钥：绝不入库 ──
*.p12
*.pfx
secrets*
credentials*
*.token
_htpasswd


# ── 开发软件配置目录：本地工具状态不上传 ──
.claude.json
.codex/
.cursor/
.gemini/
.windsurf/
.trae/
.roo/
.aider*
continue/
.aws/
.ssh/


# ── 内部文档与开发状态：不入版本控制，避免泄漏 ──
# README.md / CHANGELOG.md / SKILL.md / references/ / evals/ 是仓库正式内容，保持跟踪
drafts/
notes/
private/
internal/
dev/
dev-notes/
.archive/
.research/
*.draft.md
*.local.md
*.wip.md
DEVLOG.md
TODO.md
STATUS.md


# ── Python 运行产物 ──
*.py[cod]
.venv/
venv/


# ── Node 前端产物 ──
build/
.next/
.nuxt/
*.tsbuildinfo


# ── 系统与临时文件 ──
Thumbs.db
desktop.ini
*.tmp
*~
